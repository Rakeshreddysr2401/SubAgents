# ============================================================
# SubAgents — PRODUCTION profile
# Copy to .env for a real multi-user deployment. Differences
# from the dev defaults, with the reasoning inline.
# ============================================================

# Real accounts required. With auth enabled and JWT_SECRET left unset, a
# machine-local secret is auto-generated at ~/.subagents/jwt_secret (0600).
AUTH_DISABLED=false
# JWT_SECRET=                              # optional explicit override

# Cookies must be Secure behind HTTPS (put a TLS proxy like Caddy in front).
COOKIE_SECURE=true

# --- LLM: your dedicated server, with a cloud fallback armed ---
LLM_PROVIDER=llama_cpp
LLAMA_CPP_BASE_URL=http://your-llm-server.local:8080/v1
SUPERVISOR_MODEL=your-model-name
LLM_SLOTS={"conversation": 0, "swiggy": 1, "tracker": 2, "planner": 3}
# FALLBACK_LLM_PROVIDER=openai
# FALLBACK_LLM_MODEL=gpt-4o-mini
# FALLBACK_LLM_API_KEY=

# --- Memory quality upgrade (recommended if you have a key) ---
# MEM0_LLM_PROVIDER=openai
# OPENAI_API_KEY=

# --- Embeddings stay local (see .env.example for the openai option) ---
EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://your-llm-server.local:11434

# --- Infrastructure: set REAL credentials (docker-compose.yml defaults are dev-only) ---
POSTGRES_DSN=postgresql://subagents:CHANGE-THIS-PASSWORD@localhost:5432/subagents
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Observability ---
# METRICS_TOKEN=                           # enables GET /metrics for Prometheus

# --- Limits (defaults shown) ---
# RATE_LIMIT_PER_MINUTE=20                 # chat/upload/auth
# API_RATE_LIMIT_PER_MINUTE=120            # panel CRUD
# EVENTS_MAX_CONNECTIONS_PER_USER=8

# --- Only if the SPA is served from a different origin ---
# CORS_ORIGINS=["https://assistant.example.com"]
