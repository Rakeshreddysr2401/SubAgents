# ============================================================
# SubAgents — environment configuration
# Copy to .env and fill in what you need. Every value has a
# sensible default (see src/configs/settings.py).
#
# ZERO-KEY LOCAL SETUP (the default): point LLAMA_CPP_BASE_URL
# at any OpenAI-compatible server (e.g. a mac-mini running
# `llama-server --parallel 4 --jinja`), run Ollama for
# embeddings (`ollama pull nomic-embed-text`), and you need no
# cloud API key at all.
# ============================================================

# --- LLM provider: llama_cpp (default) | openai | anthropic | gemini | ollama ---
LLM_PROVIDER=llama_cpp
# Your LLM server — any OpenAI-compatible endpoint, e.g. a mac-mini on the LAN
# running llama.cpp (`llama-server --parallel 4 --jinja`).
LLAMA_CPP_BASE_URL=http://localhost:8080/v1
SUPERVISOR_MODEL=multimodal-model          # model name loaded in the llama.cpp server
# Generic overrides that win for any provider (empty = derive from the above):
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=                             # anthropic/gemini keys can also come from
#                                          # ANTHROPIC_API_KEY / GOOGLE_API_KEY
# LLM_MAX_TOKENS=
# Per-agent llama.cpp KV-cache slot pinning (server needs --parallel N).
# Each agent keeps its own slot so prompt prefixes stay cached:
# LLM_SLOTS={"conversation": 0, "swiggy": 1, "tracker": 2, "planner": 3}
# Per-agent provider/model overrides (JSON):
# AGENT_LLM_OVERRIDES={"planner": {"provider": "openai", "model": "gpt-4o"}}

# --- Cloud fallback: used automatically while the primary LLM is down ---
# FALLBACK_LLM_PROVIDER=openai
# FALLBACK_LLM_MODEL=gpt-4o-mini
# FALLBACK_LLM_API_KEY=

# --- Cloud providers (only needed if used above) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
UTILITY_MODEL=gpt-4o-mini                  # cheap model for summaries / background work

# --- Vision (VLM) endpoint for image analysis (guardian mode, frame checks) ---
# Defaults to LLAMA_CPP_BASE_URL / SUPERVISOR_MODEL — set explicitly if the
# chat model runs elsewhere but the VLM lives on a llama.cpp server.
# VISION_LLM_PROVIDER=                     # empty = OpenAI-compatible (llama.cpp)
# VISION_LLM_BASE_URL=http://localhost:8080/v1
# VISION_MODEL=multimodal-model

# --- Embeddings: "ollama" (768d, fully local, default) or "openai" (1536d) ---
# Collections are dimension-suffixed (documents_768, …), so switching provider
# is non-destructive — you just re-ingest into the new collections and clean
# up the old ones with scripts/migrate_qdrant.py.
EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434   # may point at a LAN server too
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text  # `ollama pull nomic-embed-text` first

# --- Infrastructure (docker compose defaults) ---
POSTGRES_DSN=postgresql://subagents:subagents@localhost:5432/subagents
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# --- Mem0 long-term memory ---
# "main" (default) follows the chat provider — zero-key local works out of the
# box. Fact extraction is noticeably better on OpenAI; upgrade with:
# MEM0_LLM_PROVIDER=openai
# MEM0_LLM_MODEL=gpt-4o-mini

# --- Auth (dev default: disabled → user_id "default_user") ---
AUTH_DISABLED=true
JWT_SECRET=change-me-in-production         # required to be a real secret when AUTH_DISABLED=false
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# COOKIE_SECURE=false                      # set true once served over HTTPS — cookies won't send over plain http otherwise

# --- Wake word ---
WAKE_WORD_ENABLED=false                    # true = run the listener inside the server (single command)
WAKE_WORD_ENGINE=openwakeword              # openwakeword (offline) | google (online)
WAKE_WORD=hey_jarvis                       # openwakeword: hey_jarvis|alexa|hey_mycroft|hey_rhasspy or a .onnx path
# WAKE_WORD_THRESHOLD=0.5                   # raise to reduce false triggers
# TRIGGER_VOICE_URL=http://localhost:2024/trigger_voice

# --- External services ---
TAVILY_API_KEY=                            # optional web search
# Swiggy MCP (food / instamart / dineout): authorize once with
#   uv run python scripts/swiggy_login.py --verify
# which writes ~/.subagents/mcp_tokens.json. The env token below is a legacy
# override; the URLs rarely need changing.
# SWIGGY_ACCESS_TOKEN=
# SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
# SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
# SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout

# --- Tracing (optional, LangSmith) ---
# LANGSMITH_API_KEY=
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=subagents

# --- Tuning knobs (defaults shown) ---
# MAX_AGENT_VISITS=3
# FRAME_TTL_SECONDS=120
# CHAT_TIMEOUT_SECONDS=120
# RATE_LIMIT_PER_MINUTE=20
# VISION_INDEXING=reuse                    # reuse | llm | off

# --- Voice, reminders, guardian, music (defaults shown) ---
# HOST_TTS_ENABLED=false                   # also speak replies via the server Mac's `say`
                                           # (the browser speaks via speechSynthesis regardless)
# REMINDER_POLL_SECONDS=15                 # how often due reminders are checked
# GUARDIAN_INTERVAL_SECONDS=20             # how often guardian mode looks at the camera
# GUARDIAN_ALERT_COOLDOWN_SECONDS=120      # minimum gap between guardian alerts per user
# MUSIC_STATIONS=[{"name": "...", "url": "https://..."}]   # browser radio stations (JSON)
